# Copy to .env (git-ignored) and fill in. Read by npm run ops and npm run mcp.

# Your workspace folder: ops.config.json, playbooks/, addons/. Set it once and
# every command and the MCP server use it (or pass --workspace to a command).
# The demo is examples/my-workspace.
# OPS_WORKSPACE=/path/to/your/workspace

# Optional. Extra addon folders, ":"-separated, to share addons between several
# workspaces. Your workspace's own addons/ is always read; most people never set this.
# OPS_ADDONS=/path/to/shared-addons

# Credentials your connectors read, e.g. a read-only database user. Keep them out of the workspace files.
# ORDERS_DB_URL=postgres://readonly:secret@db.internal:5432/shop
