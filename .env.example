# Copy to .env (git-ignored) and fill in. Read by npm run ops and npm run mcp.

# Where the config is (default ops.config.json in the working directory)
# OPS_CONFIG=/path/to/ops.config.json

# Credentials your connectors read, e.g. a read-only database user. Keep them out of ops.config.json.
# ORDERS_DB_URL=postgres://readonly:secret@db.internal:5432/shop
