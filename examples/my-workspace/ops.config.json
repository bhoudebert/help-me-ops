{
  "apps": {
    "shop": {
      "description": "Online shop: orders, payments, the confirmation worker",
      "envs": {
        "prod": {
          "sources": [
            {
              "id": "app-logs",
              "type": "file-logs",
              "path": "logs/prod.log",
              "description": "Application logs of the API, payments, worker, deploy and support services, one event per line"
            }
          ],
          "addons": {
            "order": {
              "path": "data/prod/orders.json"
            },
            "metrics": {
              "path": "data/prod/metrics.json"
            },
            "health": {
              "path": "data/prod/health.json"
            },
            "shopdb": {
              "url": "${SHOPDB_PROD_URL}"
            },
            "rest": {
              "baseUrl": "${SHOP_API_PROD_URL}",
              "allow": "/orders,/health",
              "token": "${SHOP_API_TOKEN}"
            },
            "datadog": {
              "baseUrl": "${SHOP_API_PROD_URL}",
              "apiKey": "${DD_API_KEY}",
              "appKey": "${DD_APP_KEY}"
            },
            "git": {
              "repo": "${SHOP_REPO}"
            }
          }
        },
        "staging": {
          "sources": [
            {
              "id": "app-logs",
              "type": "file-logs",
              "path": "logs/staging.log",
              "description": "Application logs of the API, payments, worker, deploy and support services, one event per line"
            }
          ],
          "addons": {
            "order": {
              "path": "data/staging/orders.json"
            },
            "metrics": {
              "path": "data/staging/metrics.json"
            },
            "health": {
              "path": "data/staging/health.json"
            },
            "shopdb": {
              "url": "${SHOPDB_STAGING_URL}"
            },
            "rest": {
              "baseUrl": "${SHOP_API_STAGING_URL}",
              "allow": "/orders,/health",
              "token": "${SHOP_API_TOKEN}"
            },
            "datadog": {
              "baseUrl": "${SHOP_API_STAGING_URL}",
              "apiKey": "${DD_API_KEY}",
              "appKey": "${DD_APP_KEY}"
            },
            "git": {
              "repo": "${SHOP_REPO}"
            }
          }
        }
      }
    }
  },
  "playbooks": "playbooks"
}
